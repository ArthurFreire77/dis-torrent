{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DisTorrent",
  "version": "1.0.0-pre-alpha.1",
  "identifier": "com.forge.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DisTorrent",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "DisTorrent",
    "category": "SocialNetworking",
    "copyright": "Copyright © 2026 DisTorrent (MIT)",
    "shortDescription": "DisTorrent — comunicação P2P cifrada fim-a-fim",
    "longDescription": "DisTorrent — comunicação P2P descentralizada, local-first e cifrada fim-a-fim. Identidade ed25519 sem cadastro, sem servidor central, com voz, vídeo, servidores, canais e compartilhamento de arquivos em swarm.",
    "targets": [
      "deb",
      "appimage"
    ],
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "languages": [
          "English",
          "PortugueseBR"
        ]
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
