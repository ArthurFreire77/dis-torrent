<?xml version="1.0" encoding="utf-8"?>
<!--
  Caminhos que podem sair por content:// para outro app.

  POR QUE ISSO EXISTE: desde o Android 7 (N) passar `file://` para outro app
  lança FileUriExposedException. O `save_file`/plugin de downloads e, agora, o
  instalador de APK do auto-update precisam entregar um arquivo ao sistema por
  `content://`.

  `files-path` cobre `data_dir/files/updates/` — é onde o Rust grava o APK
  baixado, DENTRO de `filesDir` (o `app_data_dir()` do Tauri no Android é
  `dataDir`, o PAI de `files`; gravar em `dataDir/updates` deixava o APK fora
  do FileProvider e o instalador nunca abria). Sem esta linha o
  `FileProvider.getUriForFile` lança IllegalArgumentException e a atualização
  no Android simplesmente não acontece.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
  <files-path name="updates" path="." />
  <cache-path name="cache" path="." />
  <external-path name="external" path="." />
</paths>
