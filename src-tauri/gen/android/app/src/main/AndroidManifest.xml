<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Sem permissões de LEITURA de mídia.
         O app grava o que baixa via plugin:downloads, que usa a pasta do próprio
         app e o seletor do sistema (SAF) — não precisa ler a galeria. Declarar
         READ_EXTERNAL_STORAGE / READ_MEDIA_* num APK distribuido fora da Play
         Store faz o Play Protect BLOQUEAR a instalação (hard block), não só
         avisar: é a regra "sensitive permissions + internet-sideloading" do
         Google. Como nada aqui lê mídia, foram removidas. -->

    <!-- Scoped storage (Android 10+): escrever FORA dos diretórios do app
         (ex: /sdcard/Download) exige SAF/MediaStore ou "All files access".
         O save_file do Rust escreve de forma atômica no diretório que o
         sistema libera e devolve erro honesto quando o caminho é negado —
         sem crash, sem arquivo corrompido com nome final. -->

    <!-- Chamadas de voz/vídeo: sem DECLARAR estas permissões o WebView nega o
         pedido em runtime (RustWebChromeClient.onPermissionRequest) e o microfone
         nunca abre — a chamada fica muda. Não exigimos hardware (required=false)
         para não bloquear instalação em aparelhos/emuladores sem câmera. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Foreground service para chamadas (Android 14+ corta mic/camera em
         background sem isto). O service (`CallForegroundService.kt`) é
         iniciado ao entrar em chamada pelo plugin `callfg` e parado ao sair —
         a notificação persistente fica visível enquanto a chamada estiver
         ativa. Só o tipo `microphone` é usado: NÃO mantemos um serviço
         permanente de "ficar online" (o Android restringe e seria desonesto
         prometer execução contínua). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- Serviço de mensageria em segundo plano (receber com o app fechado). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Atualização automática: o app baixa o APK e abre o instalador do
         sistema. Desde o Android 8 esta permissão é OBRIGATÓRIA para disparar
         um `ACTION_VIEW` de APK; sem ela o instalador nem abre (falha muda).
         Ela NÃO permite instalar sozinho: o usuário confirma no instalador do
         Android, que é o máximo que um app fora da loja pode fazer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 13+: sem isto o sistema NÃO mostra notificação nenhuma (nem de
         chamada, nem de mensagem). É pedida em runtime (NotificationPrompt /
         tela de configurações), nunca no boot. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Chamada em TELA CHEIA (estilo WhatsApp) com o aparelho bloqueado: o
         Android 14+ exige esta permissão de uso especial para aceitar
         `setFullScreenIntent`. Sem ela o aviso vira só banner na gaveta — e a
         chamada "não aparece" com o app em segundo plano. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Despertar a tela quando a chamada chega com o aparelho bloqueado. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Compartilhamento de TELA no Android: NÃO existe hoje.
         `CAPTURE_VIDEO_OUTPUT` é permissão de nível `signature` (só apps
         assinados com a chave do sistema a recebem) e o wry 0.57 não mapeia
         display-capture no `onPermissionRequest` — declarar a permissão não
         habilitava nada e só sugeria uma capacidade falsa. O caminho nativo em
         Rust também não existe no Android (`cfg(target_os = "linux")`). A UI
         mostra "captura de tela indisponível neste aparelho", que é a verdade.
         Para ter MediaProjection seria preciso: permissão própria, foreground
         service `mediaProjection` + notificação e implementação nativa. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.distorrent"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="distorrent" android:host="invite" />
            </intent-filter>
        </activity>

        <!-- Serviço de chamada em primeiro plano. `foregroundServiceType`
             precisa bater com o que o `startForeground` pede no código, senão
             o Android 14+ lança SecurityException. -->
        <service
            android:name=".CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera" />

        <!-- Serviço que mantém o app conectado com a tela apagada (receber
             mensagem/chamada com o app fechado). `remoteMessaging` é o tipo que
             o Android define para mensageria — diferente de `dataSync`, que no
             Android 15 tem teto de horas por dia. -->
        <service
            android:name=".BackgroundConnectionService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />

        <!-- Atender/Recusar tocados na notificação de chamada. Precisa de
             receiver PRÓPRIO (não de `PendingIntent.getActivity`): com o app em
             segundo plano/bloqueado, tocar no botão abriria a tela de bloqueio
             em vez de aplicar a escolha. `exported="false"` — só o nosso
             PendingIntent dispara. -->
        <receiver
            android:name=".CallActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.distorrent.app.CALL_ACCEPT" />
                <action android:name="com.distorrent.app.CALL_REJECT" />
            </intent-filter>
        </receiver>

        <!-- Permissão de chamada em tela cheia (Android 14+ exige declarar o
             uso; sem ela o `setFullScreenIntent` é rebaixado a banner). -->
        <meta-data
            android:name="android.app.role.DIALER_USES_FULL_SCREEN_INTENT"
            android:value="true" />

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
