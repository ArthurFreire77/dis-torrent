# DisTorrent v2.2.0 — configurações de ambiente (copie para .env ou exporte)
# Nenhuma variável é obrigatória: o app funciona 100% offline/LAN sem este arquivo.

# ── Descoberta pela internet (bootstrap) ────────────────────────────────────
# Tracker HTTP opcional onde o app anuncia seu IP:porta e consulta amigos
# pendentes. Pode apontar para SUA instância self-hosted (ver host/).
# Em privacidade "Seguro +" ou "Tor", o announce é DESLIGADO no motor.
FORGE_BOOTSTRAP_URL=https://forge-bootstrap.fly.dev

# ── Privacidade: proxy / Tor (modos "Seguro +" e "Tor — 7 nós") ────────────
# SOCKS5 local. Instale um proxy/Tor próprio — nada vem embutido.
# Nesses modos o app roteia TAMBÉM o relay por aqui (ntfy via socks5h), então
# o P2P sem abrir porta continua funcionando SEM vazar o IP real. O announce
# de IP público e o hole punch ficam DESLIGADOS (não fazem sentido anônimos).
FORGE_PROXY_ADDR=127.0.0.1:1080
FORGE_TOR_ADDR=127.0.0.1:9050

# ── Logs ────────────────────────────────────────────────────────────────────
# Ex.: info,forge_core=debug para ver handshake/conexões do motor.
RUST_LOG=info
